{
  "name": "create-devi",
  "version": "3.6.5",
  "description": "A CLI tool for scaffolding React projects with modern tooling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-devi": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node index.ts",
    "dev": "ts-node-dev --respawn index.ts",
    "clean": "shx rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "devi",
    "webakash1806",
    "react",
    "cli",
    "typescript",
    "tailwind",
    "shadcn",
    "scaffold"
  ],
  "author": {
    "name": "Akash Kumar Singh",
    "email": "webakash1806@gmail.com",
    "url": "https://github.com/webakash1806"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webakash1806/devi-package.git"
  },
  "bugs": {
    "url": "https://github.com/webakash1806/devi-package/issues"
  },
  "homepage": "https://github.com/webakash1806/devi-package#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "inquirer": "^12.5.0"
  }
}
